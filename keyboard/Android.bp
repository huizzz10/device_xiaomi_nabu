cc_binary {
    name: "XiaomiKeyboard",
    srcs: ["XiaomiKeyboard.c"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    init_rc: ["XiaomiKeyboard.rc"],
    shared_libs: [
        "liblog",
    ],
    system_ext_specific: true,
}
