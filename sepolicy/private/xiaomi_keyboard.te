type xiaomi_keyboard, domain, coredomain;
type xiaomi_keyboard_exec, exec_type, system_file_type, file_type;

init_daemon_domain(xiaomi_keyboard)

allow xiaomi_keyboard usb_device:chr_file rw_file_perms;
allow xiaomi_keyboard usb_device:dir r_dir_perms;

allow xiaomi_keyboard logd:unix_stream_socket connectto;
allow xiaomi_keyboard { logdw_socket logdr_socket }:unix_stream_socket { connectto read write };
